{
  "name": "signalguard-functions",
  "version": "1.0.0",
  "description": "SignalGuard Cloud Functions Backend for Intelligent Alert Fatigue Reduction",
  "main": "lib/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^4.7.1",
    "@google-cloud/tasks": "^5.5.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "@types/node": "^20.14.9",
    "firebase-functions-test": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  },
  "private": true
}
