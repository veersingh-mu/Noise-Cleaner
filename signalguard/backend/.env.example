PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL 15)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/signalguard?schema=public

# Redis 7
REDIS_URL=redis://redis:6379

# Alert Channels
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/MOCK/TOKEN/SIGNALGUARD
PAGERDUTY_ROUTING_KEY=mock-pd-routing-key-signalguard
PAGERDUTY_ENDPOINT=https://events.pagerduty.com/v2/enqueue
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/mock/signalguard
